<template>
  <view class="quark-webview">
    <nvue-navbar class="wil-navbar" title="夸克网盘" @handleConfirm="handleConfirm" v-if="platform != 'TV'"></nvue-navbar>
    <wil-webview type="web" :platform="platform" :src="url" style="flex: 1" @getcookies="getCookies" class="wil-webview" v-if="url" />
  </view>
</template>

<script>
import NvueNavbar from '@/components/mobile/wil-navbar/navbar.nvue'
import { getQuarkFolder, getQuarkUser } from '@/utils/common'
import { addOperLog } from '@/network/apis'
import { renameAccount } from '@/utils/sources/mulu'
import { openFolderPicker, FOLDER_PICKER_PATH } from '@/utils/sources/picker'

export default {
  components: {
    NvueNavbar,
  },
  data() {
    return {
      url: '',
      sum: 0,
      debounceCookie: null,
      timeout: null,
      sourceList: [],
      quarkCookie: '',
      routerParams: {},
      oldName: '',
      platform: '',
      timer: null, // 用于保存定时器ID
    }
  },
  methods: {
    editMulu(newName) {
      // 账号昵称变化时同步改名目录配置（entries 与旧桶一并处理）
      renameAccount('夸克网盘', this.oldName, newName)
    },
    getCookies(event) {
      this.quarkCookie = event.detail.cookies
      this.sourceList = uni.getStorageSync('sourceList')
    },
    async handleConfirm() {
      let cloudQuark = this.sourceList.find(item => {
        return item.type == '夸克网盘'
      })
      if (!this.quarkCookie) {
        uni.showToast({
          title: '权限校验失败，请稍后',
          icon: 'none',
        })
        return
      }
      let res = await getQuarkFolder(
        {
          fid: '0',
        },
        {
          Cookie: this.quarkCookie,
        }
      )

      if (res.status == 200) {
        let res1 = await getQuarkUser({
          Cookie: this.quarkCookie,
        })
        if (cloudQuark.list.length) {
          this.oldName = cloudQuark.list[0].name
          if (cloudQuark.list[0].name != res1.data.nickname) {
            let historyArr = uni.getStorageSync('historyPlay') || []
            historyArr = historyArr.filter(v => v.sourceType != '夸克网盘' || v.sourceName != cloudQuark.list[0].name)
            uni.setStorageSync('historyPlay', historyArr)
            this.editMulu(res1.data.nickname) //修改电视剧电影目录
          }
          cloudQuark.list[0].name = res1.data.nickname
          cloudQuark.list[0].Cookie = this.quarkCookie
          uni.setStorageSync('sourceList', this.sourceList)
          uni.showToast({
            title: '修改成功',
            icon: 'none',
          })
          // 修改同样进目录树：回填已导入目录，允许增删
          if (this.routerParams.isActive == '1') {
            uni.setStorageSync('isreload', true)
          }
          this.clearTimer()
          setTimeout(() => {
            openFolderPicker({
              type: '夸克网盘',
              name: res1.data.nickname,
              mode: 'edit',
              // 回退层数由 openFolderPicker 按页面栈推导，这里只需要区分端
              path: this.platform === 'TV' ? FOLDER_PICKER_PATH.tv : undefined,
            })
          }, 1500)
          return
        } else {
          let obj = {
            name: res1.data.nickname,
            Cookie: this.quarkCookie,
          }
          let isHaveData = !this.sourceList.every(item => {
            return !item.list.length
          })
          if (!isHaveData) {
            obj.active = true
            uni.setStorageSync('isreload', true)
          }
          cloudQuark.list.push(obj)
          uni.setStorageSync('sourceList', this.sourceList)
          uni.showToast({
            title: '添加成功',
            icon: 'none',
          })
          this.clearTimer()
          setTimeout(() => {
            // 新增账号后直接进导入页，勾选要扫描的目录
            openFolderPicker({
              type: '夸克网盘',
              name: obj.name,
              mode: 'add',
              path: this.platform === 'TV' ? FOLDER_PICKER_PATH.tv : undefined,
            })
          }, 1800)
          addOperLog({ title: '登录夸克网盘', businessType: 12, operatorType: 2, operUrl: '' })
          return
        }
      } else {
        uni.showToast({
          title: '权限校验失败，请稍后',
          icon: 'none',
        })
        return
      }
    },
    clearTimer() {
      if (this.timer) {
        clearInterval(this.timer)
        this.timer = null
      }
    },
    startTimer() {
      this.clearTimer()
      this.timer = setInterval(() => {
        this.handleConfirm()
      }, 30000)
    },
  },
  onLoad(options) {
    this.routerParams = options
    this.url = options.url ? decodeURIComponent(options.url) : ''
    this.platform = options.platform || ''
    if (this.platform === 'TV') {
      uni.showToast({
        title: '请等待,每隔30秒刷新登录状态',
        icon: 'none',
      })
      this.startTimer()
    }
  },
  beforeDestroy() {
    this.clearTimer()
  },
}
</script>

<style lang="scss">
.quark-webview {
  flex: 1;
  display: flex;
  flex-direction: column;

  .wil-webview {
    flex: 1;
  }
}
</style>
